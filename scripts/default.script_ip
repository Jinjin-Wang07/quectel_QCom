#!/bin/sh
# Busybox udhcpc dispatcher script. Copyright (C) 2009 by Axel Beckert.
#
# Based on the busybox example scripts and the old udhcp source
# package default.* scripts.

RESOLV_CONF="/etc/resolv.conf"
RESOLV_CONF_BACKUP="/tmp/resolv.conf.${interface}.udhcpc.backup"
IPCMD=`which ip`

is_systemd_resolved_active()
{
	command -v resolvectl >/dev/null 2>&1 && [ -d /run/systemd/resolve ]
}

is_legacy_resolvconf()
{
	[ -x /sbin/resolvconf ] && [ "$(basename "$(readlink -f /sbin/resolvconf 2>/dev/null)")" != "resolvectl" ]
}

update_dns()
{
	if is_systemd_resolved_active; then
		if [ -n "$dns" ]; then
			resolvectl dns "$interface" $dns
			if [ -n "$domain" ]; then
				resolvectl domain "$interface" "$domain" "~."
			else
				resolvectl domain "$interface" "~."
			fi
			resolvectl default-route "$interface" yes
		fi
	elif is_legacy_resolvconf; then
		echo -n "$R" | /sbin/resolvconf -a "${interface}.udhcpc"
	else
		[ -e "$RESOLV_CONF" ] && [ ! -e "$RESOLV_CONF_BACKUP" ] && cp -p "$RESOLV_CONF" "$RESOLV_CONF_BACKUP"
		echo -n "$R" > "$RESOLV_CONF"
	fi
}

clear_dns()
{
	if is_systemd_resolved_active; then
		resolvectl revert "$interface"
	elif is_legacy_resolvconf; then
		/sbin/resolvconf -d "${interface}.udhcpc"
	elif [ -e "$RESOLV_CONF_BACKUP" ]; then
		cat "$RESOLV_CONF_BACKUP" > "$RESOLV_CONF"
		rm -f "$RESOLV_CONF_BACKUP"
	fi
}

netmask_to_prefix()
{
	case "$1" in
		255.255.255.255) echo 32 ;;
		255.255.255.254) echo 31 ;;
		255.255.255.252) echo 30 ;;
		255.255.255.248) echo 29 ;;
		255.255.255.240) echo 28 ;;
		255.255.255.224) echo 27 ;;
		255.255.255.192) echo 26 ;;
		255.255.255.128) echo 25 ;;
		255.255.255.0) echo 24 ;;
		255.255.254.0) echo 23 ;;
		255.255.252.0) echo 22 ;;
		255.255.248.0) echo 21 ;;
		255.255.240.0) echo 20 ;;
		255.255.224.0) echo 19 ;;
		255.255.192.0) echo 18 ;;
		255.255.128.0) echo 17 ;;
		255.255.0.0) echo 16 ;;
		255.254.0.0) echo 15 ;;
		255.252.0.0) echo 14 ;;
		255.248.0.0) echo 13 ;;
		255.240.0.0) echo 12 ;;
		255.224.0.0) echo 11 ;;
		255.192.0.0) echo 10 ;;
		255.128.0.0) echo 9 ;;
		255.0.0.0) echo 8 ;;
		254.0.0.0) echo 7 ;;
		252.0.0.0) echo 6 ;;
		248.0.0.0) echo 5 ;;
		240.0.0.0) echo 4 ;;
		224.0.0.0) echo 3 ;;
		192.0.0.0) echo 2 ;;
		128.0.0.0) echo 1 ;;
		0.0.0.0) echo 0 ;;
		*) echo "$1" ;;
	esac
}

case $1 in
    bound|renew)
	prefix=$(netmask_to_prefix "$subnet")
	if [ -n "$broadcast" ]; then
		$IPCMD address replace "$ip/$prefix" broadcast "$broadcast" dev "$interface"
	else
		$IPCMD address replace "$ip/$prefix" dev "$interface"
	fi

	if [ -n "$router" ]; then
	    echo "$0: Resetting default routes"
	    while $IPCMD route del default dev "$interface" 2>/dev/null; do :; done

	    metric=0
	    for i in $router; do
		$IPCMD route replace default dev "$interface" via "$i" metric $metric
		metric=$(($metric + 1))
	    done
	fi

	# Update resolver configuration file
	R=""
	[ -n "$domain" ] && R="domain $domain
"
	for i in $dns; do
	    echo "$0: Adding DNS $i"
	    R="${R}nameserver $i
"
	done

	update_dns
	;;

    deconfig)
	clear_dns
	$IPCMD address flush dev "$interface"
	;;

    leasefail)
	echo "$0: Lease failed: $message"
	;;

    nak)
	echo "$0: Received a NAK: $message"
	;;

    *)
	echo "$0: Unknown udhcpc command: $1";
	exit 1;
	;;
esac
